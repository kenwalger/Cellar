{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "Preserve",
    "moduleDetection": "force",
    "isolatedModules": true,
    // `react-jsx`, not `preserve`. tsc is still only a checker here — `noEmit`
    // is set and the bundlers do the transform — but this setting is read by
    // more than tsc. Vite 8 bundles through rolldown/oxc, which takes its JSX
    // handling from tsconfig and refuses the syntax outright under `preserve`
    // ("JSX syntax is disabled and should be enabled via the parser options").
    // The public build is the surface that surfaced it; `sanity build` was
    // re-run after this change and is unaffected.
    "jsx": "react-jsx",
    "incremental": true,
    // `node --test` runs `src/*.ts` directly and Node's ESM resolver does not
    // guess extensions, so view modules a test imports must write `./dates.ts`
    // rather than `./dates`. Vite, which is what actually builds this app,
    // accepts both. `noEmit` states what was already true: tsc is a checker
    // here and `sanity build` does the bundling.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
